# Server Configuration
PORT=8080
GIN_MODE=debug

# Model Configuration
MODEL_PATH=./models

# API Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
MAX_BATCH_SIZE=10

# Preprocessing Configuration
TARGET_WIDTH=1024
TARGET_HEIGHT=768
ENABLE_DESKEW=true

# OCR Engine: tesseract | easyocr | trocr | paddleocr | ensemble
# DEFAULT_ENGINE=tesseract

# Training (for fine-tuning TrOCR on Turkish data)
# TRAINING_DATA_DIR=./training_data
# TROCR_BASE_MODEL=microsoft/trocr-base-printed
